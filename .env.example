NODE_ENV=development
PORT=3002
AUTH0_ISSUER=https://your-tenant.example.auth0.com/
AUTH0_AUDIENCE=https://nines-api.local
DATABASE_URL=postgresql://localhost:5432/nines_api
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
KYC_PROVIDER=fake
KYC_SESSION_TTL_MINUTES=60
KYC_VERIFICATION_TTL_DAYS=365
KYC_PROVIDER_MAX_FUTURE_SKEW_SECONDS=300
ENABLE_FAKE_KYC_TEST_ROUTES=false
# Public browser origin for development-only hosted mock KYC URLs.
PUBLIC_API_BASE_URL=http://localhost:3002
CRYPTO_FUNDING_ENABLED=false
# Explicitly set to fake only for development/test funding flows.
# CRYPTO_PROVIDER=fake
CRYPTO_SUPPORTED_ASSETS=USDC:6
CRYPTO_FUNDING_MIN_AMOUNT=1
CRYPTO_FUNDING_MAX_AMOUNT=100000
CRYPTO_FUNDING_INTENT_TTL_MINUTES=60
CRYPTO_PROVIDER_MAX_FUTURE_SKEW_SECONDS=300
# Required (minimum 16 characters) when the fake crypto provider is enabled.
# CRYPTO_FAKE_WEBHOOK_SECRET=replace-with-development-secret

# Integration tests only. Use a dedicated database whose name ends in _test.
TEST_DATABASE_URL=postgresql://localhost:5432/nines_api_phase1_test
